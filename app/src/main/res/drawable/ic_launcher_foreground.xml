<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Quantum Ring with segmented accents -->
    <path
        android:pathData="M54,54 m-28,0 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0"
        android:strokeWidth="1.5"
        android:strokeColor="#26C6DA"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Orbital Ring Nodes -->
    <path
        android:pathData="M54,26 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0"
        android:fillColor="#80DEEA" />
    <path
        android:pathData="M54,82 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0"
        android:fillColor="#80DEEA" />
    <path
        android:pathData="M26,54 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0"
        android:fillColor="#80DEEA" />
    <path
        android:pathData="M82,54 m-2.5,0 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0"
        android:fillColor="#80DEEA" />

    <!-- Middle Precision Ring -->
    <path
        android:pathData="M54,54 m-20,0 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0"
        android:strokeWidth="2"
        android:strokeColor="#00B0FF"
        android:fillColor="#00000000" />

    <!-- Inner Energy Halo with gradient -->
    <path
        android:pathData="M54,54 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="14"
                android:type="radial">
                <item android:color="#E0F7FA" android:offset="0.0" />
                <item android:color="#80D8FF" android:offset="0.6" />
                <item android:color="#0091EA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Core Center Spark -->
    <path
        android:pathData="M54,46 L56,52 L62,54 L56,56 L54,62 L52,56 L46,54 L52,52 Z"
        android:fillColor="#FFFFFF" />
</vector>
